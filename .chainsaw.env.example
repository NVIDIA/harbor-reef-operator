# Copy to .chainsaw.env (gitignored) and edit for your environment.
#
# Required for the chainsaw e2e suite. The Makefile sources this file
# before invoking chainsaw. CI runners are expected to set the same
# variables from a secret store instead of using this file.

# Full Harbor URL including scheme.
HARBOR_API_BASE=https://harbor.example.com

# Harbor host only, no scheme. Used to build the broken-image path in
# the pod-fallback suite.
HARBOR_API_HOST=harbor.example.com

# Plaintext Harbor admin password. If you leave this unset the Makefile
# will try to pull it from the in-cluster admin secret via kubectl.
# HARBOR_ADMIN_PASS=